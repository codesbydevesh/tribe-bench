 },
 "downscale": "480p",
 "selection_rule": {
  "outcome_blind": "No brain data exists or was consulted. Every step is mechanical and deterministic (seed 0).",
  "shot_boundary": "any frame with ffmpeg scene_score > 0.05 on a 160px downscale of the full film (169,625 frames scanned). Deliberately sensitive: over-detection only costs candidates, under-detection is the defect being fixed. The 0.4 default reported 0.13 cuts/clip against 2.20 actual.",
  "window": "10.0 s lying strictly inside ONE shot with a 0.5 s cut-free guard on both sides; 0.5 s stride; first/last 120 s of the film excluded (titles/credits)",
  "face": "union of haarcascade_frontalface_default and _alt2 (scaleFactor 1.08, minNeighbors 6, minSize 40px on 480x270) finds a face of area >= 0.025 of frame in >= 80% of the 21 samples, median area >= 0.025, AND at the first sample, AND in >= 80% of the first 4 s, AND the two cascades AGREE in >= 30% of samples and at the first sample. Agreement is required because a persistent single-cascade false positive was observed (union area ~0.040 on every sample of a wide corridor shot, agreement 0.000 throughout).",
  "nonface": "the same high-precision detector NEVER finds a face of area >= 0.020 anywhere in the window, AND people are present (profile detections in >= 30% of samples), preserving D021's stated control that both conditions contain people",
  "one_per_shot": "at most one clip per shot; the shot's median-motion window is its fixed representative",
  "independence": "no two of the 30 clips within 45 s of each other, enforced ACROSS conditions",
  "matching": "EXHAUSTIVE over all 1536 feasible 15+15 selections (one clip per shot, all 30 clips >=45s apart across conditions), choosing the set that minimises |AUC-0.5| of motion measured on the DELIVERED 480p clips, tie-broken on |SMD| of log motion. This is a global optimum over the feasible set, not a heuristic. Pairwise greedy matching was tried first and rejected: it optimises pairwise distance, which is not what the criterion measures (set-level rank balance).",
  "acceptance": "evaluated ON THE DELIVERED CLIPS: two-sided permutation p >= 0.20 on motion AND |AUC-0.5| <= 0.10 AND |SMD| <= 0.25 on LOG motion. Balance is certified in RANKS because the primary gate (G1) is a rank test (Mann-Whitney U). Raw SMD on a positive, wide-range energy measure is outlier-dominated and uninformative here: the rejected v3 set had raw SMD -0.097 (passing) while its rank separation AUC 0.631 failed."
 },
